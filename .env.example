# ==========================================
# APP & AUTHENTICATION CONFIGURATION
# ==========================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-key-here"
NEXT_PUBLIC_ADMIN_PASS="your-admin-password"

# Google OAuth (NextAuth)
GOOGLE_CLIENT_ID="your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
MONGODB_URI="mongodb+srv://username:password@cluster.mongodb.net/database-name?retryWrites=true&w=majority"

# ==========================================
# ZOHO BOOKS INTEGRATION
# ==========================================
ZOHO_CLIENT_ID="your-zoho-client-id"
ZOHO_CLIENT_SECRET="your-zoho-client-secret"
ZOHO_REFRESH_TOKEN="your-zoho-refresh-token"
ZOHO_ORG_ID="your-zoho-organization-id"

# ==========================================
# SHIPPING & LOGISTICS APIs
# ==========================================
# Delhivery Courier API
DELHIVERY_API_TOKEN="your-delhivery-api-token"
DELHIVERY_ENV="staging" # "staging" or "production"

# Shadowfax Courier API
SHADOWFAX_API_TOKEN="your-shadowfax-api-token"
SHADOWFAX_ENV="staging" # "staging" or "production"

# ==========================================
# GOOGLE SHEETS SYNC INTEGRATION
# ==========================================
GOOGLE_SERVICE_ACCOUNT_EMAIL="service-account@project-id.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-private-key-here\n-----END PRIVATE KEY-----"
GOOGLE_SHEET_ID="your-google-sheet-id"

# ==========================================
# THIRD-PARTY & INTERNAL API KEYS
# ==========================================
FREEASTRO_API_KEY="your-freeastro-api-key"
AZURE_OPENAI_API_KEY="your-azure-openai-api-key"
ADMIN_API_KEY="your-admin-api-key"
HP_API_KEY="your-hp-api-key"
RESEND_API_KEY="your-resend-api-key"
